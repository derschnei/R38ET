# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file types
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.catala text eol=lf
*.catala_en text eol=lf
*.catala_de text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
